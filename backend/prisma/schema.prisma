generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Tabla de usuarios según especificaciones exactas
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // bcrypt hash
  role      String
  createdAt DateTime @default(now())
  
  auditLogs AuditLog[]

  @@map("users")
}

// Tabla de páginas según especificaciones exactas
model Page {
  id           String    @id // usa slug como ID (ej. home, quienes-somos)
  title        String
  draft_json   String?   // JSON string
  published_json String? // JSON string
  craftData    String?   // Craft.js JSON structure
  status       String    @default("draft") // 'draft'|'published'
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?
  version      Int       @default(1)

  @@map("pages")
}

// Tabla de assets según especificaciones exactas
model Asset {
  id        Int      @id @default(autoincrement())
  url       String
  filename  String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  @@map("assets")
}

// Tabla de audit logs según especificaciones exactas
model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // create, update, publish, upload
  entity    String   // page, asset
  entity_id String
  user_id   Int?
  meta      String?  // JSON
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

// Mantener tabla de invoices existente para no romper funcionalidad
model Invoice {
  id            Int      @id @default(autoincrement())
  accountNumber String   @unique
  customerName  String
  amount        Float
  description   String?
  status        String   @default("pending")
  dueDate       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("invoices")
}