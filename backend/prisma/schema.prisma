generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  name           String?
  firstName      String
  lastName       String
  phone          String?
  role           String          @default("USER")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoices       Invoice[]
  pqrs           PQR[]
  reportComments ReportComment[]
  reports        Report[]
  sessions       UserSession[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Report {
  id          String          @id @default(cuid())
  title       String
  description String
  type        String
  status      String          @default("PENDING")
  priority    String          @default("MEDIUM")
  createdBy   String
  assignedTo  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  comments    ReportComment[]
  files       ReportFile[]
  creator     User            @relation(fields: [createdBy], references: [id])

  @@map("reports")
}

model ReportFile {
  id         String   @id @default(cuid())
  reportId   String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_files")
}

model ReportComment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_comments")
}

model PQR {
  id           String    @id @default(cuid())
  type         String
  subject      String
  description  String
  status       String    @default("RECEIVED")
  priority     String    @default("MEDIUM")
  createdBy    String
  assignedTo   String?
  responseText String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?
  files        PQRFile[]
  creator      User      @relation(fields: [createdBy], references: [id])

  @@map("pqrs")
}

model PQRFile {
  id         String   @id @default(cuid())
  pqrId      String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())
  pqr        PQR      @relation(fields: [pqrId], references: [id], onDelete: Cascade)

  @@map("pqr_files")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  userId        String
  period        String
  issueDate     DateTime
  dueDate       DateTime
  amount        Float
  status        String        @default("PENDING")
  paymentDate   DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         InvoiceItem[]
  user          User          @relation(fields: [userId], references: [id])
  payments      Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  total       Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  amount        Float
  paymentMethod String
  transactionId String?
  status        String    @default("PENDING")
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Page {
  id              String        @id @default(cuid())
  name            String        @default("")
  title           String
  description     String?
  slug            String        @unique
  content         String?
  grapesData      String?
  html            String?
  css             String?
  gjsHtml         String?
  gjsCss          String?
  gjsComponents   String        @default("[]")
  gjsStyles       String        @default("[]")
  publishedHtml   String?
  publishedCss    String?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean       @default(false)
  isActive        Boolean       @default(true)
  publishedAt     DateTime?
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  backups         PageBackup[]
  versions        PageVersion[]

  @@map("pages")
}

model PageBackup {
  id            String   @id @default(cuid())
  pageId        String
  title         String
  gjsHtml       String
  gjsCss        String
  gjsComponents String
  gjsStyles     String
  createdAt     DateTime @default(now())
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_backups")
}

model PageVersion {
  id            String   @id @default(cuid())
  pageId        String
  title         String
  gjsHtml       String?
  gjsCss        String?
  gjsComponents String?
  gjsStyles     String?
  html          String?
  css           String?
  publishedHtml String?
  publishedCss  String?
  grapesData    String?
  version       Int?
  note          String?
  createdAt     DateTime @default(now())
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_versions")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
