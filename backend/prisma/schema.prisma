// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      String @default("USER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  reports   Report[]
  pqrs      PQR[]
  invoices  Invoice[]
  sessions  UserSession[]
  reportComments ReportComment[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Report {
  id          String     @id @default(cuid())
  title       String
  description String
  type        String
  status      String @default("PENDING")
  priority    String @default("MEDIUM")
  createdBy   String
  assignedTo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relaciones
  creator   User @relation(fields: [createdBy], references: [id])
  files     ReportFile[]
  comments  ReportComment[]

  @@map("reports")
}

model ReportFile {
  id       String @id @default(cuid())
  reportId String
  fileName String
  filePath String
  fileSize Int
  mimeType String
  uploadedAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_files")
}

model ReportComment {
  id       String @id @default(cuid())
  reportId String
  userId   String
  content  String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("report_comments")
}

model PQR {
  id          String    @id @default(cuid())
  type        String
  subject     String
  description String
  status      String @default("RECEIVED")
  priority    String @default("MEDIUM")
  createdBy   String
  assignedTo  String?
  responseText String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  // Relaciones
  creator User @relation(fields: [createdBy], references: [id])
  files   PQRFile[]

  @@map("pqrs")
}

model PQRFile {
  id       String @id @default(cuid())
  pqrId    String
  fileName String
  filePath String
  fileSize Int
  mimeType String
  uploadedAt DateTime @default(now())

  pqr PQR @relation(fields: [pqrId], references: [id], onDelete: Cascade)

  @@map("pqr_files")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  userId        String
  period        String        // Formato: YYYY-MM
  issueDate     DateTime
  dueDate       DateTime
  amount        Float
  status        String @default("PENDING")
  paymentDate   DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relaciones
  user         User           @relation(fields: [userId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  total       Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Float
  paymentMethod String
  transactionId String?
  status        String @default("PENDING")
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Page {
  id              String   @id @default(cuid())
  name            String   @default("")
  title           String
  slug            String   @unique
  content         String?  // Legacy content field
  grapesData      String?  // Legacy GrapesJS data field
  html            String?  // Generated HTML for public view
  css             String?  // Generated CSS for public view
  gjsHtml         String   @default("") // GrapesJS HTML content
  gjsCss          String   @default("") // GrapesJS CSS content
  gjsComponents   String   @default("[]") // GrapesJS Components JSON
  gjsStyles       String   @default("[]") // GrapesJS Styles JSON
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  backups         PageBackup[]

  @@map("pages")
}

model PageBackup {
  id            String   @id @default(cuid())
  pageId        String
  title         String
  gjsHtml       String   // GrapesJS HTML content backup
  gjsCss        String   // GrapesJS CSS content backup
  gjsComponents String   // GrapesJS Components JSON backup
  gjsStyles     String   // GrapesJS Styles JSON backup
  createdAt     DateTime @default(now())

  // Relaciones
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_backups")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("STRING")
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// Note: SQLite doesn't support enums, so we use strings with default values
// UserRole: ADMIN, MANAGER, USER
// ReportType: MAINTENANCE, BILLING, SERVICE, COMPLAINT, OTHER
// ReportStatus: PENDING, IN_PROGRESS, RESOLVED, CLOSED
// Priority: LOW, MEDIUM, HIGH, URGENT
// PQRType: PETITION, COMPLAINT, CLAIM, SUGGESTION
// PQRStatus: RECEIVED, IN_REVIEW, IN_PROGRESS, RESOLVED, CLOSED
// InvoiceStatus: PENDING, SENT, PAID, OVERDUE, CANCELLED
// PaymentMethod: CASH, BANK_TRANSFER, CREDIT_CARD, CHECK, OTHER
// PaymentStatus: PENDING, COMPLETED, FAILED, REFUNDED
// SettingType: STRING, NUMBER, BOOLEAN, JSON