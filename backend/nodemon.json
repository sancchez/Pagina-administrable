{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": [
    "node_modules",
    "dist",
    "logs",
    "*.log",
    "tests",
    "coverage",
    ".git"
  ],
  "exec": "ts-node --transpile-only",
  "env": {
    "NODE_ENV": "development",
    "PORT": "4000",
    "FRONTEND_URL": "http://localhost:5174"
  },
  "delay": 1000
}